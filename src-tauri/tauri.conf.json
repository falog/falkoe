{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Falkoe",
  "version": "0.2.4",
  "identifier": "com.fal.falkoe",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Falkoe",
        "devtools": true,
        "resizable": true,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "fal",
    "shortDescription": "Falkoe application",
    "longDescription": "Falkoe - Your application description here",
    "linux": {
      "deb": {
        "files": {}
      }
    },
    "windows": {
      "wix": {
        "language": "ja-JP"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
